# Dev image: Node 20 + build tools for canvas/erlpack native modules.
# Upstream targets Node 14-16, so native builds break on Node 22.
FROM node:20-bookworm

# System deps for canvas@2 + bufferutil + erlpack
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential python3 pkg-config \
    libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package*.json ./
# Install with --ignore-scripts first so native modules don't fail immediately;
# rebuild them manually if needed.
RUN npm ci --ignore-scripts --no-audit --no-fund || npm install --ignore-scripts --no-audit --no-fund
COPY . .
CMD ["node", "index.js"]
