# Copy to .env OR to secret/env for local runs (without docker).
# Upstream reads BOT_TOKEN from .env first, then falls back to ./secret/env (see index.js:7-15).
BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Match docker-compose.yml when using compose:
MYSQL_HOST=localhost
MYSQL_USER=owo
MYSQL_PASS=owo_pass

REDIS_HOST=localhost
REDIS_PASS=

# The rest is optional for debug=true mode (default in src/data/config.json).
# Leave empty for now; the bot still runs a single local shard.
CLIENT_ID=
CLIENT_SECRET=
DBL_TOKEN=
