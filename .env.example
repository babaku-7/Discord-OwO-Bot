# Copy ke .env ATAU ke secret/env untuk jalan lokal (tanpa docker).
# Upstream baca BOT_TOKEN dari .env dulu, fallback ke ./secret/env (lihat index.js:7-15).
BOT_TOKEN=ISI_TOKEN_BOT_DISCORD_LU_DISINI

# Samakan dengan docker-compose.yml bila pakai compose:
MYSQL_HOST=localhost
MYSQL_USER=owo
MYSQL_PASS=owo_pass

REDIS_HOST=localhost
REDIS_PASS=

# Sisanya optional untuk mode debug=true (default di src/data/config.json).
# Biarkan kosong dulu, bot tetap jalan 1 shard lokal.
CLIENT_ID=
CLIENT_SECRET=
DBL_TOKEN=
